"""Minimal type stub for gmpy2 (2.3.x ships no .pyi or py.typed).

Types only the names the e and pi sub-projects and their tests use. It
deliberately contains no `Any`: every operand is a precise union, so a typo or
a wrong argument type is still reported. Extend it when a sub-project starts
using another gmpy2 name; tests/test_gmpy2_stub.py fails until it is added.
"""

from typing import SupportsIndex, overload

class mpz:
    def __init__(self, n: _IntLike | str | float = 0, base: int = 0) -> None: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __hash__(self) -> int: ...
    def __neg__(self) -> mpz: ...
    def __pos__(self) -> mpz: ...
    def __abs__(self) -> mpz: ...
    def __add__(self, other: _IntLike) -> mpz: ...
    def __radd__(self, other: _IntLike) -> mpz: ...
    def __sub__(self, other: _IntLike) -> mpz: ...
    def __rsub__(self, other: _IntLike) -> mpz: ...
    def __mul__(self, other: _IntLike) -> mpz: ...
    def __rmul__(self, other: _IntLike) -> mpz: ...
    def __floordiv__(self, other: _IntLike) -> mpz: ...
    def __rfloordiv__(self, other: _IntLike) -> mpz: ...
    def __mod__(self, other: _IntLike) -> mpz: ...
    def __rmod__(self, other: _IntLike) -> mpz: ...
    def __pow__(self, exponent: _IntLike) -> mpz: ...
    def __rpow__(self, base: _IntLike) -> mpz: ...
    def __lshift__(self, count: SupportsIndex) -> mpz: ...
    def __rshift__(self, count: SupportsIndex) -> mpz: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: _IntLike) -> bool: ...
    def __le__(self, other: _IntLike) -> bool: ...
    def __gt__(self, other: _IntLike) -> bool: ...
    def __ge__(self, other: _IntLike) -> bool: ...

class mpfr:
    @overload
    def __init__(self, n: _RealLike | str = 0, precision: int = 0) -> None: ...
    @overload
    def __init__(self, n: str, precision: int, base: int) -> None: ...
    def __int__(self) -> int: ...
    def __float__(self) -> float: ...
    def __bool__(self) -> bool: ...
    def __hash__(self) -> int: ...
    def __neg__(self) -> mpfr: ...
    def __pos__(self) -> mpfr: ...
    def __abs__(self) -> mpfr: ...
    def __add__(self, other: _RealLike) -> mpfr: ...
    def __radd__(self, other: _RealLike) -> mpfr: ...
    def __sub__(self, other: _RealLike) -> mpfr: ...
    def __rsub__(self, other: _RealLike) -> mpfr: ...
    def __mul__(self, other: _RealLike) -> mpfr: ...
    def __rmul__(self, other: _RealLike) -> mpfr: ...
    def __truediv__(self, other: _RealLike) -> mpfr: ...
    def __rtruediv__(self, other: _RealLike) -> mpfr: ...
    def __pow__(self, exponent: _RealLike) -> mpfr: ...
    def __rpow__(self, base: _RealLike) -> mpfr: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: _RealLike) -> bool: ...
    def __le__(self, other: _RealLike) -> bool: ...
    def __gt__(self, other: _RealLike) -> bool: ...
    def __ge__(self, other: _RealLike) -> bool: ...
    def digits(self, base: int = 10, prec: int = 0) -> tuple[str, int, int]: ...

_IntLike = int | mpz
_RealLike = int | float | mpz | mpfr

class context:
    precision: int

def get_context() -> context: ...
def sqrt(x: _RealLike) -> mpfr: ...
def version() -> str: ...
def mp_version() -> str: ...
def mpfr_version() -> str: ...
