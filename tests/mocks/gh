#!/usr/bin/env bash
printf "gh %s\n" "$*" >> "${MOCK_CALLS_FILE:-/tmp/mock_calls}"

# Failure is selectable per subcommand via MOCK_GH_EXIT_<SUBCOMMAND>_<VERB>, derived
# from "$1_$2" upper-cased with non-alphanumerics stripped: `gh issue close` reads
# MOCK_GH_EXIT_ISSUE_CLOSE, `gh label create` reads MOCK_GH_EXIT_LABEL_CREATE.
# MOCK_GH_EXIT remains the all-calls-fail fallback (ci_gate.bats relies on it).
_key="MOCK_GH_EXIT_$(printf '%s_%s' "${1:-}" "${2:-}" \
    | tr 'a-z-' 'A-Z_' | tr -cd '[:alnum:]_')"
_rc="${!_key:-${MOCK_GH_EXIT:-0}}"
if [[ "${_rc}" -ne 0 ]]; then
    exit "${_rc}"
fi
# Both paginated ci-gate calls share MOCK_GH_EXIT_API_PAGINATE, so the
# workflow-runs lookup gets its own URL-keyed failure switch.
if [[ "$*" == *"actions/runs"* && "${MOCK_GH_EXIT_ACTIONS_RUNS:-0}" -ne 0 ]]; then
    exit "${MOCK_GH_EXIT_ACTIONS_RUNS}"
fi

# Artifact fixtures for publish-coverage-badges.sh: ${MOCK_GH_ARTIFACT_ROOT}/<run id>/
# holds one directory per artifact (coverage-badge-<project>-<lang>/<project>/<lang>.json).
_artifact_run=""
if [[ -n "${MOCK_GH_ARTIFACT_ROOT:-}" && "$*" =~ actions/runs/([0-9]+)/artifacts ]]; then
    _artifact_run="${BASH_REMATCH[1]}"
fi

if [[ -n "${_artifact_run}" ]]; then
    ls -1 "${MOCK_GH_ARTIFACT_ROOT}/${_artifact_run}" 2>/dev/null
elif [[ "$1" == "run" && "$2" == "download" && -n "${MOCK_GH_ARTIFACT_ROOT:-}" ]]; then
    _dest=""
    for ((_i = 1; _i <= $#; _i++)); do
        if [[ "${!_i}" == "--dir" ]]; then
            _j=$((_i + 1))
            _dest="${!_j}"
        fi
    done
    mkdir -p "${_dest}"
    cp -R "${MOCK_GH_ARTIFACT_ROOT}/$3/." "${_dest}/"
elif [[ "$*" == *"check-runs"* ]]; then
    _counter_file="${MOCK_GH_COUNTER_FILE:-/tmp/gh_counter}"
    _count=$(cat "${_counter_file}" 2>/dev/null || printf "0")
    _count=$((_count + 1))
    printf "%d\n" "${_count}" > "${_counter_file}"
    _var="MOCK_GH_CHECK_RUNS_${_count}"
    _fallback="MOCK_GH_CHECK_RUNS"
    printf '%s\n' "${!_var:-${!_fallback:-}}"
elif [[ "$*" == *"actions/runs"* ]]; then
    # MOCK_GH_WORKFLOW_RUNS_RAW (opt-in): raw workflow_runs JSON run through the caller's
    # real --jq filter, so a test can prove which runs the filter keeps.
    if [[ -n "${MOCK_GH_WORKFLOW_RUNS_RAW:-}" ]]; then
        _filter=""
        for ((_i = 1; _i <= $#; _i++)); do
            if [[ "${!_i}" == "--jq" ]]; then
                _j=$((_i + 1))
                _filter="${!_j}"
            fi
        done
        printf '%s\n' "${MOCK_GH_WORKFLOW_RUNS_RAW}" | jq -r "${_filter}"
    else
        printf '%s\n' "${MOCK_GH_WORKFLOW_RUNS:-}"
    fi
elif [[ "$*" == *"pulls"* ]]; then
    printf '%s\n' "${MOCK_GH_PR_SHA:-abc123def456}"
elif [[ "$1" == "issue" ]]; then
    printf '%s\n' "${MOCK_GH_ISSUE_LIST:-}"
else
    printf '%s\n' "${MOCK_GH_OUTPUT:-}"
fi
