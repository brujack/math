# Git worktrees
.worktrees/

# Local cargo cache (rust-check.sh transient artifact)
.cache/

# Shared CARGO_TARGET_DIR for maintainability_check.py's rust checker.
# Already covered by .cache/ above; listed explicitly so the directory's
# owner is discoverable from this file alone.
.cache/cargo-target-rust-checker/

# Claude Code local settings (machine-specific)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# 10-80-10 loop logs — session-local, not source
.claude/loop-log/*.jsonl
.claude/triage-log/*.jsonl

# Phase 3 review-cycle telemetry (finishing-a-development-branch)
.claude/review-cycle/*.jsonl

# docs skill audit manifests — session-local, not source
.claude/docs-audit/*.jsonl

# subagent cost logs — session-local, not source
.claude/cost-log/*.jsonl

# Credential files — never commit
.aws/
.azure_creds/
.gcloud_creds/
.tf_creds/
.tsh/
*.pem
*.key
*_rsa
*_ed25519

