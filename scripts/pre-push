#!/usr/bin/env bash
# Pre-push hook: runs tests for changed sub-projects before push reaches GitHub.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# GitHub Actions is the final merge gate on PRs.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    REPO_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)" \
        || { printf "pre-push: could not determine repo root\n" >&2; exit 1; }
fi
DIRS_TO_TEST=()
# The sub-project loop below only ever matches `<dir>/*.py` or `<dir>/**/*.rs`,
# so a change to the hooks themselves, or to the bats suites that cover them,
# matched nothing and pushed with no local test at all. CI's scripts.yml caught
# it, but only after the push.
RUN_HOOK_TESTS=0

# local_ref and remote_ref are unused, but git's pre-push protocol writes all
# four fields per line in this order — they are positional placeholders, not
# dead variables (SC2034).
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${local_sha}" = "0000000000000000000000000000000000000000" ]] && continue

    if [[ "${remote_sha}" = "0000000000000000000000000000000000000000" ]]; then
        base="$(git merge-base "${local_sha}" origin/master 2>/dev/null \
            || git rev-list --max-parents=0 "${local_sha}")"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    for dir in pi pi/pi-rs prime/prime-rs fib fib/fib-rs sq sq/sq-rs twin-primes/twin-primes-rs e e/e-rs factorial factorial/factorial-rs perfect-numbers perfect-numbers/perfect-numbers-rs collatz collatz/collatz-rs goldbach/goldbach-rs amicable amicable/amicable-rs; do
        # Only trigger tests when Python or Rust source changed, not Makefiles
        # or workflow files. Makefile/CI changes don't affect test outcomes.
        #
        # Match each sub-project the way its own CI workflow does: a `*-rs`
        # workflow watches `<dir>/**`, a Python one watches the single-level
        # glob `<dir>/*.py`. A deep pattern on a Python dir also matches its
        # own nested `<dir>/<dir>-rs/...` sources, so a Rust-only push would
        # run the unrelated Python suite.
        case "${dir}" in
            *-rs) _pattern="^${dir}/.*\.rs$" ;;
            *) _pattern="^${dir}/[^/]*\.py$" ;;
        esac
        if git diff --name-only "${range}" | grep -qE "${_pattern}"; then
            DIRS_TO_TEST+=("${dir}")
        fi
    done

    if git diff --name-only "${range}" | grep -qE '^scripts/|^tests/|^Makefile$|^\.github/workflows/mutation-testing.*\.yml$|^\.github/workflows/release-.*\.yml$|^\.github/actions/|^pyrightconfig\.json$|^requirements-dev\.txt$|^\.claude/scripts/|^\.github/workflows/scripts\.yml$'; then
        RUN_HOOK_TESTS=1
    fi
done

# Must run before both early exits below. The "no sub-projects" exit fires on
# exactly the case this clause exists for — a scripts/- or bats-only push has an
# empty DIRS_TO_TEST — and the >6 bail-out is about macOS process-isolation
# limits in the Python suites, which the bats suite does not share.
if [[ "${RUN_HOOK_TESTS}" -eq 1 ]]; then
    printf "test: hooks and scripts (bats)\n"
    make -C "${REPO_ROOT}" test < /dev/null || exit 1
fi

if [[ "${#DIRS_TO_TEST[@]}" -eq 0 ]]; then
    printf "No changed sub-projects detected. Skipping tests.\n"
    exit 0
fi

# Cross-cutting changes (>6 sub-projects) cause Python multiprocessing
# resource_tracker daemons to accumulate across sequential suites on macOS,
# exhausting semaphores and hanging. CI runs each job in isolation — it is
# the correct gate for large-scope changes. Skip locally and let CI handle it.
UNIQUE_DIRS=()
while IFS= read -r d; do UNIQUE_DIRS+=("$d"); done \
    < <(printf '%s\n' "${DIRS_TO_TEST[@]}" | sort -u)

if [[ "${#UNIQUE_DIRS[@]}" -gt 6 ]]; then
    printf "pre-push: %d sub-projects changed — skipping local tests (too many for macOS process isolation).\n" "${#UNIQUE_DIRS[@]}"
    printf "CI will run all suites in isolation. Push proceeding.\n"
    exit 0
fi

for dir in "${UNIQUE_DIRS[@]}"; do
    printf "test: %s\n" "${dir}"
    # Redirect stdin from /dev/null — prevents Python multiprocessing
    # resource_tracker from inheriting git's push pipe and deadlocking.
    make -C "${REPO_ROOT}/${dir}" test < /dev/null
done
