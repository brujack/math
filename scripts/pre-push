#!/usr/bin/env -S bash -p
# Pre-push hook: runs tests for changed sub-projects before push reaches GitHub.
# A push to master or main first loads the shared push-content gate from
# ai-config (the wiring block below); it reads stdin once, into _pcg_refs, which
# the ref loop then reads again. `bash -p` keeps BASH_ENV out of the hook.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# GitHub Actions is the final merge gate on PRs.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    REPO_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)" \
        || { printf "pre-push: could not determine repo root\n" >&2; exit 1; }
fi
# The installed hook is a symlink into the main checkout; resolve it by hand
# (BSD readlink has no -f on older macOS) to find the runner beside the target.
_src="${BASH_SOURCE[0]}"
while [[ -L "${_src}" ]]; do
    _link="$(readlink "${_src}")"
    case "${_link}" in
        /*) _src="${_link}" ;;
        *) _src="$(dirname "${_src}")/${_link}" ;;
    esac
done
HOOK_DIR="$(cd "$(dirname "${_src}")" && pwd -P)"
DIRS_TO_TEST=()
# The sub-project loop below only ever matches `<dir>/*.py` or `<dir>/**/*.rs`,
# so a change to the hooks themselves, or to the bats suites that cover them,
# matched nothing and pushed with no local test at all. CI's scripts.yml caught
# it, but only after the push.
RUN_HOOK_TESTS=0
# Neither trigger above matches `<dir>/install_deps.sh`, so a push touching only
# an installer reached no shellcheck at all. Any pushed `.sh` path runs the root
# lint-hooks target, which lints every tracked shell file and spawns no Python.
RUN_SHELL_LINT=0
# Set when the shared CLI harness itself changed. The harness checks every
# Python CLI, so it runs alone over them (no pytest) regardless of which
# sub-project suites the push selects.
RUN_CLI_CONTRACT=0
# Set when a crate's src/ or .cargo/mutants.toml changed: an exclude_re entry
# embeds a line number, so the drift check must confirm each still matches.
RUN_MUTANTS_CHECK=0
# Set when a mutants-equivalent.toml or a Python module changed: an entry is keyed
# by source line text, so the check must confirm each still resolves to one mutant.
RUN_EQUIVALENTS_CHECK=0
# SHAs refused by the CLAUDE.md byte-ceiling check; acted on after the ref loop
# so every pushed ref is examined and the refusal precedes all early exits.
budget_refusals=()

# >>> push-content-gate wiring
# >>> _pcg_fetch
_pcg_fetch() { # <api path>; prints the raw file. curl reads no user-writable configuration; the token comes from gh's own store.
  local tok ca
  tok="$(gh auth token 2>/dev/null)" || return 1
  case "${tok}" in '' | *[!A-Za-z0-9_]*) return 1 ;; *) ;; esac
  for ca in /etc/ssl/certs/ca-certificates.crt /etc/ssl/cert.pem ''; do [[ -r "${ca}" ]] && break; done
  [[ -n "${ca}" ]] || return 1
  printf 'header = "Authorization: Bearer %s"\n' "${tok}" \
    | env -i /usr/bin/curl -q --silent --show-error --fail --proto '=https' --noproxy '*' \
        --cacert "${ca}" --max-time 20 -K - -H 'Accept: application/vnd.github.raw' \
        "https://api.github.com/${1}"
}
# <<< _pcg_fetch
_pcg_refs="$(</dev/stdin)" || { printf 'pre-push: cannot read the pushed refs\n' >&2; exit 1; }
_pcg_hit=1
while read -r _ _ _pcg_rref _; do
  case "${_pcg_rref}" in refs/heads/master | refs/heads/main) _pcg_hit=0 ;; *) ;; esac
done <<< "${_pcg_refs}"
if [[ "${_pcg_hit}" -eq 0 ]]; then
  # shellcheck disable=SC1090,SC2310,SC2311 # the library is fetched at runtime, so there is no file to follow; a failed fetch is handled by the else arm, not by set -e
  if _pcg_src="$(_pcg_fetch 'repos/brujack/ai-config/contents/.claude/hooks/push-content-gate.sh?ref=master')" \
    && source <(printf '%s\n' "${_pcg_src}") \
    && declare -F push_content_gate_refs >/dev/null; then
    push_content_gate_refs "${_pcg_refs}" "${2}" || exit 1
  else
    printf 'pre-push: cannot load the push-content gate from GitHub (brujack/ai-config master); refusing a push to master/main.\n' >&2
    printf 'Check the network and gh auth status, then retry.\n' >&2
    exit 1
  fi
fi
# <<< push-content-gate wiring
# >>> push-gates wiring
# ADR-0099 sub-project 2A: load the push gates from ai-config master at one SHA and
# run them on every push not exempt under R17. Byte-identical in every repo; each repo pins its sha256.
# R17: a push whose every ref is a deletion or a docs-only branch skips the gates and
# reads no GitHub endpoint; the decision uses only the pushed refs and local git, and
# any doubt (new branch, no origin/HEAD, a merge commit, an unreadable object) loads the
# gates as before. A docs-only branch is one whose every commit since its merge-base with
# origin/HEAD, the range the gates judge, changes only inert docs paths. The exemption
# applies only to a push to the remote named origin whose one fetch URL and one push
# URL both equal the hook's URL argument: origin/HEAD describes origin's fetch URL and
# says nothing about any other remote's or push target's default branch. Each non-deleted
# ref must also be a branch whose tracking ref refs/remotes/origin/<branch>, which must
# exist as exactly that ref (a tag of a lookalike name does not count), equals the
# remote sha being replaced: that proves origin/HEAD and the pushed history belong to the
# remote being pushed to (a set-url without a fetch leaves both describing the old one).
_pg_git() { # git against the pushing repository, ignoring replace refs and inherited GIT_* repository and object-store variables
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES git --no-replace-objects "$@" 2> /dev/null
}
# shellcheck disable=SC2310,SC2311,SC2312 # every status here is the answer and is tested explicitly; set -e being off inside the function is intended
_pg_path_inert() { # <commit> <path>; 0 when the path is on the safe list and is, at <commit>, absent or a plain non-script blob
  local ent rest blob size head2
  case "${2}" in
    *.md | *.txt | *.rst | *.mdc | renovate.json | .gitleaks.toml | .editorconfig | .gitignore | LICENSE) ;;
    *) return 1 ;;
  esac
  ent="$(_pg_git --literal-pathspecs ls-tree --full-tree "${1}" -- "${2}")" || return 1
  [[ -n "${ent}" ]] || return 0
  [[ "${ent}" != *$'\n'* ]] || return 1
  case "${ent%% *}" in 100644 | 100755) ;; *) return 1 ;; esac
  rest="${ent#* }"
  rest="${rest#* }"
  blob="${rest%%$'\t'*}"
  [[ "${blob}" =~ ^[0-9a-f]{40}$ ]] || return 1
  _pg_git cat-file -e "${blob}" || return 1
  size="$(_pg_git cat-file -s "${blob}")" || return 1
  [[ "${size}" =~ ^[0-9]+$ ]] || return 1
  [[ "${size}" -ge 2 ]] || return 0
  IFS= read -r -n 2 -d '' head2 < <(_pg_git cat-file blob "${blob}")
  [[ -n "${head2}" && "${head2}" != '#!' ]]
}
# shellcheck disable=SC2310,SC2311,SC2312 # every status here is the answer and is tested explicitly; set -e being off inside the function is intended
_pg_commit_inert() { # <commit>; 0 when every path the commit changes is inert at that commit; a failed diff-tree yields one path no safe-list entry matches
  local path
  while IFS= read -r -d '' path; do
    _pg_path_inert "${1}" "${path}" || return 1
  done < <(_pg_git diff-tree -r -z --name-only --no-renames --no-commit-id --ignore-submodules=none --root "${1}" || printf 'diff-failed\0')
  return 0
}
# shellcheck disable=SC2310,SC2311,SC2312 # every status here is the answer and is tested explicitly; set -e being off inside the function is intended
_pg_docs_only() { # <local sha>; 0 when no merge commit and only inert commits lie between its merge-base with origin/HEAD and it
  local base merges commits commit
  _pg_git rev-parse --verify -q refs/remotes/origin/HEAD > /dev/null || return 1
  base="$(_pg_git merge-base "${1}" refs/remotes/origin/HEAD)" || return 1
  merges="$(_pg_git rev-list --min-parents=2 "${base}..${1}")" || return 1
  [[ -z "${merges}" ]] || return 1
  commits="$(_pg_git rev-list "${base}..${1}")" || return 1
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] || continue
    _pg_commit_inert "${commit}" || return 1
  done <<< "${commits}"
  return 0
}
# shellcheck disable=SC2310,SC2311,SC2312 # every status here is the answer and is tested explicitly; set -e being off inside the function is intended
_pg_exempt() { # <remote name> <url> <refs text>; 0 when the push goes to origin, whose sole fetch and push URL is <url>, and there is at least one ref and each is a deletion or a docs-only branch
  local lref lsha rref rsha furl purl track tref n=0
  [[ "${1}" == origin ]] || return 1
  furl="$(_pg_git remote get-url --all origin)" || return 1
  purl="$(_pg_git remote get-url --push --all origin)" || return 1
  [[ "${furl}" != *$'\n'* && "${purl}" != *$'\n'* ]] || return 1
  [[ "${furl}" == "${2}" && "${purl}" == "${2}" ]] || return 1
  while IFS=' ' read -r lref lsha rref rsha _; do
    [[ -n "${lref}${lsha}${rref}${rsha}" ]] || continue
    n=$((n + 1))
    [[ "${lsha}" =~ ^[0-9a-f]{40}$ ]] || return 1
    [[ "${lsha}" =~ ^0{40}$ ]] && continue
    # A zero remote sha is a new branch; the tracking-ref compare below would also refuse it
    # (no tracking ref equals zeros), so this check is defence in depth, not the only guard.
    [[ "${rsha}" =~ ^[0-9a-f]{40}$ && ! "${rsha}" =~ ^0{40}$ ]] || return 1
    [[ "${rref}" == refs/heads/?* ]] || return 1
    tref="refs/remotes/origin/${rref#refs/heads/}"
    _pg_git show-ref --verify -q "${tref}" || return 1
    track="$(_pg_git rev-parse --verify -q "${tref}^{commit}")" || return 1
    [[ "${track}" == "${rsha}" ]] || return 1
    _pg_docs_only "${lsha}" || return 1
  done <<< "${3}"
  [[ "${n}" -gt 0 ]]
}
# shellcheck disable=SC2310 # a refused exemption must fall through to the gates, so set -e being off inside _pg_exempt is intended
if _pg_exempt "${1-}" "${2-}" "${_pcg_refs}"; then
  printf 'pre-push: gates: every pushed ref is a deletion or a docs-only branch; gates not run\n' >&2
else
  # shellcheck disable=SC2310,SC2311 # a failed fetch leaves the variable empty, which the checks below block on; set -e must not end the hook first
  _pg_json="$(_pcg_fetch 'repos/brujack/ai-config/commits/master')" || _pg_json=""
  _pg_sha="$(printf '%s' "${_pg_json}" | env -i "PATH=${PATH}" "HOME=${HOME}" ${PYENV_ROOT+"PYENV_ROOT=${PYENV_ROOT}"} ${PYENV_VERSION+"PYENV_VERSION=${PYENV_VERSION}"} python3 -I -c 'import json, sys
print(json.load(sys.stdin)["sha"])' 2> /dev/null)" || _pg_sha=""
  _pg_src=""
  if [[ "${_pg_sha}" =~ ^[0-9a-f]{40}$ ]]; then
    # shellcheck disable=SC2310,SC2311 # a failed fetch leaves the variable empty, which the checks below block on; set -e must not end the hook first
    _pg_src="$(_pcg_fetch "repos/brujack/ai-config/contents/.claude/hooks/push-gates.sh?ref=${_pg_sha}")" || _pg_src=""
  fi
  # shellcheck source=/dev/null
  if [[ -z "${_pg_src}" ]] || ! source <(printf '%s\n' "${_pg_src}") || ! declare -F push_gates_run > /dev/null; then
    printf 'pre-push: gates: cannot load push gates from GitHub; push blocked\n' >&2
    exit 1
  fi
  push_gates_run "${2}" "${_pcg_refs}" "${_pg_sha}" || exit 1
fi
# <<< push-gates wiring

# Enforces the CLAUDE.md byte ceiling for one pushed commit. The change test
# diffs against merge-base(sha, origin/master), not the remote ref's old SHA, so
# a rebase onto (or merge from) an over-ceiling master is not counted as this
# branch's own CLAUDE.md change. A merge-base failure falls back to the root
# commit, as the new-branch range below does; it refuses only when that
# fallback also yields no base. A failed diff, an unreadable tree and an
# unreadable checker refuse too: only a tree that lists no checker is skipped.
# `git diff --quiet` is read explicitly: 0 unchanged, 1 changed, anything else
# is an error. Appends to budget_refusals on failure.
check_claude_md_budget() {
    local sha="$1" base rc=0 tmp listing tree_rc=0
    base="$(git merge-base "${sha}" origin/master 2>/dev/null \
        || git rev-list --max-parents=0 "${sha}" 2>/dev/null)" || base=""
    base="${base%%$'\n'*}"
    if [[ -z "${base}" ]]; then
        printf "refusing %s: cannot determine a base to test whether it changes CLAUDE.md\n" "${sha}" >&2
        budget_refusals+=("${sha}")
        return 0
    fi
    git diff --quiet "${base}" "${sha}" -- CLAUDE.md 2>/dev/null || rc=$?
    case "${rc}" in
        0) return 0 ;;
        1) ;;
        *)
            printf "refusing %s: cannot determine whether it changes CLAUDE.md (git diff exited %s)\n" "${sha}" "${rc}" >&2
            budget_refusals+=("${sha}")
            return 0
            ;;
    esac

    # Status is captured apart from the output: an ls-tree failure must not read
    # as "this commit has no checker", which skips the check.
    listing="$(git ls-tree "${sha}" -- scripts/claude_md_budget.py 2>/dev/null)" || tree_rc=$?
    if [[ "${tree_rc}" -ne 0 ]]; then
        printf "refusing %s: cannot read tree of %s (git ls-tree exited %s)\n" "${sha}" "${sha}" "${tree_rc}" >&2
        budget_refusals+=("${sha}")
        return 0
    fi
    if [[ -z "${listing}" ]]; then
        printf "skipping CLAUDE.md byte ceiling for %s: that commit has no scripts/claude_md_budget.py\n" "${sha}"
        return 0
    fi
    # The checker is read from the pushed commit and run against that commit.
    # There is no pipe: `&&` keeps a failed `git show` from running an empty file.
    tmp="$(mktemp)" || {
        printf "refusing %s: cannot create a temp file for the CLAUDE.md checker\n" "${sha}" >&2
        budget_refusals+=("${sha}")
        return 0
    }
    if git show "${sha}:scripts/claude_md_budget.py" > "${tmp}"; then
        # -I: the temp file lives in a shared directory, and without it Python
        # puts that directory first on sys.path, so a planted subprocess.py runs.
        if python3 -I "${tmp}" "${sha}" < /dev/null; then
            printf "CLAUDE.md byte ceiling OK for %s\n" "${sha}"
        else
            printf "refusing %s: CLAUDE.md byte ceiling check failed\n" "${sha}" >&2
            budget_refusals+=("${sha}")
        fi
    else
        printf "refusing %s: cannot read scripts/claude_md_budget.py from %s\n" "${sha}" "${sha}" >&2
        budget_refusals+=("${sha}")
    fi
    rm -f "${tmp}"
}

# Paths whose change can create a mutation-gate item (spec R29): equivalents and
# cosmic-ray config, crate src and mutants config, workflows, the mutation scripts,
# the allowed-signers file, the weakening fixtures and any Makefile.
readonly MUTATION_ITEM_PATHS='^[^/]+/mutants-equivalent\.toml$|^[^/]+/cosmic-ray\.toml$|^[^/]+/[^/]+-rs/\.cargo/mutants\.toml$|^[^/]+/[^/]+-rs/src/.*\.rs$|^\.github/workflows/|^scripts/mutation[-_]|^scripts/cosmic_ray_|^\.github/mutation-gate-allowed-signers$|^tests/fixtures/mutation_weakening/|(^|/)Makefile$'

# Advisory only (spec R29, N3): prints the mutation-gate items for <sha> and whether
# a verified trailer already clears them. It runs no mutant (the items script only
# lists them) and always returns 0: an items finding, a usage or infra exit, a missing
# script or a failed lookup prints one line and lets the push continue.
# Usage: advise_mutation_items <local sha> <remote ref> <range>
advise_mutation_items() {
    local sha="$1" rref="$2" range="$3"
    local items="${REPO_ROOT}/scripts/mutation-gate-items.sh"
    local base branch pr out rc=0

    if ! git diff --no-renames --name-only "${range}" 2>/dev/null | grep -qE "${MUTATION_ITEM_PATHS}"; then
        return 0
    fi
    printf "mutation gate items (advisory; the push is not blocked):\n"
    if [[ ! -x "${items}" ]]; then
        printf "pre-push: mutation gate items: script not found; push continues\n"
        return 0
    fi
    base="$(git merge-base "${sha}" origin/master 2>/dev/null)" || base=""
    base="${base%%$'\n'*}"
    if [[ -z "${base}" ]]; then
        printf "pre-push: mutation gate items: no merge base with origin/master; push continues\n"
        return 0
    fi

    pr=""
    branch="${rref#refs/heads/}"
    if [[ "${branch}" != "${rref}" ]] && command -v gh > /dev/null 2>&1; then
        pr="$(gh pr view "${branch}" --json number --jq .number < /dev/null 2>/dev/null)" || pr=""
    fi
    if [[ "${pr}" =~ ^[0-9]+$ ]]; then
        out="$("${items}" "${base}" "${sha}" --pr "${pr}" < /dev/null 2>&1)" || rc=$?
    else
        printf "no PR yet: sign after opening it\n"
        out="$("${items}" "${base}" "${sha}" < /dev/null 2>&1)" || rc=$?
    fi
    [[ -z "${out}" ]] || printf '%s\n' "${out}"
    case "${rc}" in
        0 | 1) ;;
        *) printf "pre-push: mutation gate items: exit %s; push continues\n" "${rc}" ;;
    esac
    return 0
}

# The wiring block already consumed stdin into _pcg_refs, so the loop reads that
# copy; an empty copy (a bare run, no refs) skips the loop as the old empty read did.
if [[ -n "${_pcg_refs}" ]]; then
# local_ref and remote_ref are unused, but git's pre-push protocol writes all
# four fields per line in this order — they are positional placeholders, not
# dead variables (SC2034).
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${local_sha}" = "0000000000000000000000000000000000000000" ]] && continue

    check_claude_md_budget "${local_sha}"

    if [[ "${remote_sha}" = "0000000000000000000000000000000000000000" ]]; then
        base="$(git merge-base "${local_sha}" origin/master 2>/dev/null \
            || git rev-list --max-parents=0 "${local_sha}")"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    # Advisory listing of mutation-gate items (R29); never changes the outcome.
    advise_mutation_items "${local_sha}" "${remote_ref}" "${range}" || printf "pre-push: mutation gate items: advisory step failed; push continues\n"

    for dir in pi pi/pi-rs prime/prime-rs fib fib/fib-rs sq sq/sq-rs twin-primes/twin-primes-rs e e/e-rs factorial factorial/factorial-rs perfect-numbers perfect-numbers/perfect-numbers-rs collatz collatz/collatz-rs goldbach/goldbach-rs amicable amicable/amicable-rs triangle descartes descartes/descartes-rs zeta/zeta-rs; do
        # Only trigger tests when Python or Rust source changed, not Makefiles
        # or workflow files. Makefile/CI changes don't affect test outcomes.
        #
        # Match each sub-project the way its own CI workflow does. A Python
        # workflow watches the single-level glob `<dir>/*.py`; a deep pattern
        # there would also match its nested `<dir>/<dir>-rs/...` sources, so a
        # Rust-only push would run the unrelated Python suite. A `*-rs`
        # workflow watches the crate's `.rs` sources and also `<parent>/*.py`
        # (the parity test runs the Python module), where <parent> is the
        # directory above `<parent>/<parent>-rs`; crates with no Python
        # sibling simply never match the second alternative.
        case "${dir}" in
            *-rs) _pattern="^${dir}/.*\.rs$|^${dir%/*}/[^/]*\.py$" ;;
            *) _pattern="^${dir}/[^/]*\.py$" ;;
        esac
        if git diff --name-only "${range}" | grep -qE "${_pattern}"; then
            DIRS_TO_TEST+=("${dir}")
        fi
    done

    if git diff --name-only "${range}" | grep -qE '^scripts/|^tests/|^Makefile$|^\.github/workflows/mutation-testing.*\.yml$|^\.github/workflows/release-.*\.yml$|^\.github/actions/|^pyrightconfig\.json$|^requirements-dev\.txt$|^\.claude/scripts/|^\.github/workflows/scripts\.yml$|^\.github/workflows/auto-merge\.yml$|^renovate\.json$|^typings/|^deny\.toml$'; then
        RUN_HOOK_TESTS=1
    fi

    if git diff --name-only "${range}" | grep -qE '\.sh$'; then
        RUN_SHELL_LINT=1
    fi

    # --no-renames: a rename lists only the new path by default, which would hide
    # the old harness path being moved away.
    if git diff --no-renames --name-only "${range}" | grep -qE '^scripts/cli_contract\.py$'; then
        RUN_CLI_CONTRACT=1
    fi

    if git diff --no-renames --name-only "${range}" | grep -qE '^[^/]+/[^/]+-rs/src/|^[^/]+/[^/]+-rs/\.cargo/mutants\.toml$'; then
        RUN_MUTANTS_CHECK=1
    fi

    if git diff --no-renames --name-only "${range}" | grep -qE '^[^/]+/mutants-equivalent\.toml$|^(amicable/amicable|collatz/collatz|descartes/descartes|e/e|factorial/factorial|fib/fib|perfect-numbers/perfect_numbers|pi/pi|sq/sq|triangle/triangle)\.py$'; then
        RUN_EQUIVALENTS_CHECK=1
    fi
done <<< "${_pcg_refs}"
fi

if [[ "${#budget_refusals[@]}" -gt 0 ]]; then
    printf "pre-push: push refused: CLAUDE.md byte ceiling (ADR-0028) failed for %s\n" "${budget_refusals[*]}" >&2
    exit 1
fi

# Must run before both early exits below. The "no sub-projects" exit fires on
# exactly the case this clause exists for — a scripts/- or bats-only push has an
# empty DIRS_TO_TEST.
if [[ "${RUN_HOOK_TESTS}" -eq 1 ]]; then
    printf "test: hooks and scripts (bats)\n"
    make -C "${REPO_ROOT}" test < /dev/null || exit 1
elif [[ "${RUN_SHELL_LINT}" -eq 1 ]]; then
    # Root `make test` runs `lint`, which already includes lint-hooks.
    printf "lint: shell scripts (shellcheck)\n"
    make -C "${REPO_ROOT}" lint-hooks < /dev/null || exit 1
fi

# Like the hook tests above, this precedes both early exits: the harness is the
# one check that must run when only scripts/cli_contract.py changed (empty
# DIRS_TO_TEST).
# Each project is (directory, program file); the harness runs from the project
# directory because it resolves the program relative to the working directory.
if [[ "${RUN_CLI_CONTRACT}" -eq 1 ]]; then
    for _entry in amicable:amicable collatz:collatz e:e factorial:factorial fib:fib perfect-numbers:perfect_numbers pi:pi sq:sq triangle:triangle descartes:descartes; do
        _dir="${_entry%%:*}"
        _module="${_entry##*:}"
        printf "cli-contract: %s\n" "${_dir}"
        (cd "${REPO_ROOT}/${_dir}" && python3 ../scripts/cli_contract.py "${_module}.py") < /dev/null \
            || { printf "pre-push: CLI contract harness failed for %s\n" "${_dir}" >&2; exit 1; }
    done
fi

# Also before the early exits: a crate src-only push may select no suite here.
if [[ "${RUN_MUTANTS_CHECK}" -eq 1 ]]; then
    printf "mutants: exclusion drift check\n"
    (cd "${REPO_ROOT}" && python3 -m unittest tests.test_mutants_exclusions) < /dev/null \
        || { printf "pre-push: mutants exclusion check failed (stale or overlapping exclude_re in a .cargo/mutants.toml)\n" >&2; exit 1; }
fi

if [[ "${RUN_EQUIVALENTS_CHECK}" -eq 1 ]]; then
    printf "mutants: equivalents check\n"
    (cd "${REPO_ROOT}" && python3 -m unittest tests.test_mutants_equivalent) < /dev/null \
        || { printf "pre-push: mutants equivalents check failed (stale or ambiguous entry in a mutants-equivalent.toml)\n" >&2; exit 1; }
fi

if [[ "${#DIRS_TO_TEST[@]}" -eq 0 ]]; then
    printf "No changed sub-projects detected. Skipping tests.\n"
    exit 0
fi

UNIQUE_DIRS=()
while IFS= read -r d; do UNIQUE_DIRS+=("$d"); done \
    < <(printf '%s\n' "${DIRS_TO_TEST[@]}" | sort -u)

# Suites run concurrently with a status file per job (parallel-make-test.sh),
# stdin from /dev/null so Python multiprocessing's resource_tracker cannot
# inherit git's push pipe. There is no sub-project-count bail-out: it was
# measured not to be needed (spec 2026-10-25 R18).
"${HOOK_DIR}/parallel-make-test.sh" "${PRE_PUSH_JOBS:-8}" "${REPO_ROOT}" "${UNIQUE_DIRS[@]}" || exit 1
