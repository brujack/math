#!/usr/bin/env bash
# Pre-push hook: runs tests for changed sub-projects before push reaches GitHub.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# GitHub Actions is the final merge gate on PRs.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    REPO_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)" \
        || { printf "pre-push: could not determine repo root\n" >&2; exit 1; }
fi
DIRS_TO_TEST=()
# The sub-project loop below only ever matches `<dir>/*.py` or `<dir>/**/*.rs`,
# so a change to the hooks themselves, or to the bats suites that cover them,
# matched nothing and pushed with no local test at all. CI's scripts.yml caught
# it, but only after the push.
RUN_HOOK_TESTS=0
# Neither trigger above matches `<dir>/install_deps.sh`, so a push touching only
# an installer reached no shellcheck at all. Any pushed `.sh` path runs the root
# lint-hooks target, which lints every tracked shell file and spawns no Python.
RUN_SHELL_LINT=0
# Set when the shared CLI harness itself changed. The harness checks all 8
# Python CLIs, so it runs alone over them (no pytest) regardless of which
# sub-project suites the push selects, and regardless of the >6 bail-out.
RUN_CLI_CONTRACT=0
# SHAs refused by the CLAUDE.md byte-ceiling check; acted on after the ref loop
# so every pushed ref is examined and the refusal precedes all early exits.
budget_refusals=()

# Enforces the CLAUDE.md byte ceiling for one pushed commit. The change test
# diffs against merge-base(sha, origin/master), not the remote ref's old SHA, so
# a rebase onto (or merge from) an over-ceiling master is not counted as this
# branch's own CLAUDE.md change. A merge-base failure falls back to the root
# commit, as the new-branch range below does; it refuses only when that
# fallback also yields no base. A failed diff, an unreadable tree and an
# unreadable checker refuse too: only a tree that lists no checker is skipped.
# `git diff --quiet` is read explicitly: 0 unchanged, 1 changed, anything else
# is an error. Appends to budget_refusals on failure.
check_claude_md_budget() {
    local sha="$1" base rc=0 tmp listing tree_rc=0
    base="$(git merge-base "${sha}" origin/master 2>/dev/null \
        || git rev-list --max-parents=0 "${sha}" 2>/dev/null)" || base=""
    base="${base%%$'\n'*}"
    if [[ -z "${base}" ]]; then
        printf "refusing %s: cannot determine a base to test whether it changes CLAUDE.md\n" "${sha}" >&2
        budget_refusals+=("${sha}")
        return 0
    fi
    git diff --quiet "${base}" "${sha}" -- CLAUDE.md 2>/dev/null || rc=$?
    case "${rc}" in
        0) return 0 ;;
        1) ;;
        *)
            printf "refusing %s: cannot determine whether it changes CLAUDE.md (git diff exited %s)\n" "${sha}" "${rc}" >&2
            budget_refusals+=("${sha}")
            return 0
            ;;
    esac

    # Status is captured apart from the output: an ls-tree failure must not read
    # as "this commit has no checker", which skips the check.
    listing="$(git ls-tree "${sha}" -- scripts/claude_md_budget.py 2>/dev/null)" || tree_rc=$?
    if [[ "${tree_rc}" -ne 0 ]]; then
        printf "refusing %s: cannot read tree of %s (git ls-tree exited %s)\n" "${sha}" "${sha}" "${tree_rc}" >&2
        budget_refusals+=("${sha}")
        return 0
    fi
    if [[ -z "${listing}" ]]; then
        printf "skipping CLAUDE.md byte ceiling for %s: that commit has no scripts/claude_md_budget.py\n" "${sha}"
        return 0
    fi
    # The checker is read from the pushed commit and run against that commit.
    # There is no pipe: `&&` keeps a failed `git show` from running an empty file.
    tmp="$(mktemp)" || {
        printf "refusing %s: cannot create a temp file for the CLAUDE.md checker\n" "${sha}" >&2
        budget_refusals+=("${sha}")
        return 0
    }
    if git show "${sha}:scripts/claude_md_budget.py" > "${tmp}"; then
        # -I: the temp file lives in a shared directory, and without it Python
        # puts that directory first on sys.path, so a planted subprocess.py runs.
        if python3 -I "${tmp}" "${sha}" < /dev/null; then
            printf "CLAUDE.md byte ceiling OK for %s\n" "${sha}"
        else
            printf "refusing %s: CLAUDE.md byte ceiling check failed\n" "${sha}" >&2
            budget_refusals+=("${sha}")
        fi
    else
        printf "refusing %s: cannot read scripts/claude_md_budget.py from %s\n" "${sha}" "${sha}" >&2
        budget_refusals+=("${sha}")
    fi
    rm -f "${tmp}"
}

# local_ref and remote_ref are unused, but git's pre-push protocol writes all
# four fields per line in this order — they are positional placeholders, not
# dead variables (SC2034).
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${local_sha}" = "0000000000000000000000000000000000000000" ]] && continue

    check_claude_md_budget "${local_sha}"

    if [[ "${remote_sha}" = "0000000000000000000000000000000000000000" ]]; then
        base="$(git merge-base "${local_sha}" origin/master 2>/dev/null \
            || git rev-list --max-parents=0 "${local_sha}")"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    for dir in pi pi/pi-rs prime/prime-rs fib fib/fib-rs sq sq/sq-rs twin-primes/twin-primes-rs e e/e-rs factorial factorial/factorial-rs perfect-numbers perfect-numbers/perfect-numbers-rs collatz collatz/collatz-rs goldbach/goldbach-rs amicable amicable/amicable-rs; do
        # Only trigger tests when Python or Rust source changed, not Makefiles
        # or workflow files. Makefile/CI changes don't affect test outcomes.
        #
        # Match each sub-project the way its own CI workflow does: a `*-rs`
        # workflow watches `<dir>/**`, a Python one watches the single-level
        # glob `<dir>/*.py`. A deep pattern on a Python dir also matches its
        # own nested `<dir>/<dir>-rs/...` sources, so a Rust-only push would
        # run the unrelated Python suite.
        case "${dir}" in
            *-rs) _pattern="^${dir}/.*\.rs$" ;;
            *) _pattern="^${dir}/[^/]*\.py$" ;;
        esac
        if git diff --name-only "${range}" | grep -qE "${_pattern}"; then
            DIRS_TO_TEST+=("${dir}")
        fi
    done

    if git diff --name-only "${range}" | grep -qE '^scripts/|^tests/|^Makefile$|^\.github/workflows/mutation-testing.*\.yml$|^\.github/workflows/release-.*\.yml$|^\.github/actions/|^pyrightconfig\.json$|^requirements-dev\.txt$|^\.claude/scripts/|^\.github/workflows/scripts\.yml$|^\.github/workflows/auto-merge\.yml$|^renovate\.json$'; then
        RUN_HOOK_TESTS=1
    fi

    if git diff --name-only "${range}" | grep -qE '\.sh$'; then
        RUN_SHELL_LINT=1
    fi

    if git diff --name-only "${range}" | grep -qE '^scripts/cli_contract\.py$'; then
        RUN_CLI_CONTRACT=1
    fi
done

if [[ "${#budget_refusals[@]}" -gt 0 ]]; then
    printf "pre-push: push refused: CLAUDE.md byte ceiling (ADR-0028) failed for %s\n" "${budget_refusals[*]}" >&2
    exit 1
fi

# Must run before both early exits below. The "no sub-projects" exit fires on
# exactly the case this clause exists for — a scripts/- or bats-only push has an
# empty DIRS_TO_TEST — and the >6 bail-out is about macOS process-isolation
# limits in the Python suites, which the bats suite does not share.
if [[ "${RUN_HOOK_TESTS}" -eq 1 ]]; then
    printf "test: hooks and scripts (bats)\n"
    make -C "${REPO_ROOT}" test < /dev/null || exit 1
elif [[ "${RUN_SHELL_LINT}" -eq 1 ]]; then
    # Root `make test` runs `lint`, which already includes lint-hooks.
    printf "lint: shell scripts (shellcheck)\n"
    make -C "${REPO_ROOT}" lint-hooks < /dev/null || exit 1
fi

# Like the hook tests above, this precedes both early exits: the harness is the
# one check that must run when only scripts/cli_contract.py changed (empty
# DIRS_TO_TEST) and when the change is wide enough to trip the >6 bail-out.
# Each project is (directory, program file); the harness runs from the project
# directory because it resolves the program relative to the working directory.
if [[ "${RUN_CLI_CONTRACT}" -eq 1 ]]; then
    for _entry in amicable:amicable collatz:collatz e:e factorial:factorial fib:fib perfect-numbers:perfect_numbers pi:pi sq:sq; do
        _dir="${_entry%%:*}"
        _module="${_entry##*:}"
        printf "cli-contract: %s\n" "${_dir}"
        (cd "${REPO_ROOT}/${_dir}" && python3 ../scripts/cli_contract.py "${_module}.py") < /dev/null \
            || { printf "pre-push: CLI contract harness failed for %s\n" "${_dir}" >&2; exit 1; }
    done
fi

if [[ "${#DIRS_TO_TEST[@]}" -eq 0 ]]; then
    printf "No changed sub-projects detected. Skipping tests.\n"
    exit 0
fi

# Cross-cutting changes (>6 sub-projects) cause Python multiprocessing
# resource_tracker daemons to accumulate across sequential suites on macOS,
# exhausting semaphores and hanging. CI runs each job in isolation — it is
# the correct gate for large-scope changes. Skip locally and let CI handle it.
UNIQUE_DIRS=()
while IFS= read -r d; do UNIQUE_DIRS+=("$d"); done \
    < <(printf '%s\n' "${DIRS_TO_TEST[@]}" | sort -u)

if [[ "${#UNIQUE_DIRS[@]}" -gt 6 ]]; then
    printf "pre-push: %d sub-projects changed — skipping local tests (too many for macOS process isolation).\n" "${#UNIQUE_DIRS[@]}"
    printf "CI will run all suites in isolation. Push proceeding.\n"
    exit 0
fi

for dir in "${UNIQUE_DIRS[@]}"; do
    printf "test: %s\n" "${dir}"
    # Redirect stdin from /dev/null — prevents Python multiprocessing
    # resource_tracker from inheriting git's push pipe and deadlocking.
    make -C "${REPO_ROOT}/${dir}" test < /dev/null
done
