#!/usr/bin/env bash
# Pre-push hook: runs tests for changed sub-projects before push reaches GitHub.
# Permanent: provides fast local feedback and conserves GitHub Actions minutes.
# GitHub Actions is the final merge gate on PRs.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
    REPO_ROOT="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)" \
        || { printf "pre-push: could not determine repo root\n" >&2; exit 1; }
fi
DIRS_TO_TEST=()

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${local_sha}" = "0000000000000000000000000000000000000000" ]] && continue

    if [[ "${remote_sha}" = "0000000000000000000000000000000000000000" ]]; then
        base="$(git merge-base "${local_sha}" origin/master 2>/dev/null \
            || git rev-list --max-parents=0 "${local_sha}")"
        range="${base}..${local_sha}"
    else
        range="${remote_sha}..${local_sha}"
    fi

    for dir in pi pi/pi-rs prime/prime-rs fib fib/fib-rs sq sq/sq-rs twin-primes/twin-primes-rs e e/e-rs factorial factorial/factorial-rs perfect-numbers perfect-numbers/perfect-numbers-rs collatz collatz/collatz-rs goldbach/goldbach-rs amicable amicable/amicable-rs; do
        if git diff --name-only "${range}" | grep -q "^${dir}/"; then
            DIRS_TO_TEST+=("${dir}")
        fi
    done
done

if [[ "${#DIRS_TO_TEST[@]}" -eq 0 ]]; then
    printf "No changed sub-projects detected. Skipping tests.\n"
    exit 0
fi

for dir in $(printf '%s\n' "${DIRS_TO_TEST[@]}" | sort -u); do
    printf "test: %s\n" "${dir}"
    # Close stdin + extra fds (3-9) that git's push protocol may leave open.
    # On macOS, Python's multiprocessing spawn context starts a resource_tracker
    # daemon that inherits open fds from the hook process. If any of those fds
    # are connected to git's push pipe, the resource_tracker blocks waiting for
    # EOF, git waits for the hook, and both deadlock. Closing fds 3-9 and
    # redirecting stdin breaks the cycle.
    make -C "${REPO_ROOT}/${dir}" test < /dev/null 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&-
done
